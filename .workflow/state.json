  "milestones": [
    {
      "id": "P1",
      "name": "Phase 1: Core Stability",
      "description": "修复 engine/recognizer/cache/ai_client/ocr/screenshot 的异常处理、资源管理和容错机制",
      "status": "completed",
      "phases": [1],
      "tasks": [
        "Engine 线程安全与异常容错",
        "Recognizer 多策略管道容错",
        "AIClient 网络容错与重试",
        "CacheDB 连接管理与线程安全",
        "OCR/Screenshot 模块容错"
      ],
      "success_criteria": [
        "AI API 调用失败时引擎不会卡死，继续下一轮截图循环",
        "OCR 模型不存在时程序正常运行（单轨 AI Vision 模式）",
        "引擎 stop() 在任何状态下都能在 5 秒内完成，不留孤儿线程",
        "缓存数据库连接在任何异常路径下都不会泄漏"
      ]
    },
    {
      "id": "P2",
      "name": "Phase 2: UI Stability",
      "description": "修复主线程阻塞、窗口竞态、错误展示和优雅关闭",
      "status": "completed",
      "phases": [2],
      "depends_on": "P1",
      "tasks": [
        "MainWindow 停止流程优化",
        "关窗竞态修复",
        "HUD 错误展示与恢复",
        "SettingsDialog/DBViewer 异常处理",
        "跨模块错误传播链"
      ],
      "success_criteria": [
        "引擎停止时 UI 主线程不冻结，按钮即时响应",
        "关闭窗口时不会出现 \"应用程序未响应\" 或残留进程",
        "所有运行时错误在 HUD 上有清晰的用户提示（非 Python traceback）",
        "配置/题库文件损坏时给出友好提示而非崩溃"
      ]
    },
    {
      "id": "P3",
      "name": "Phase 3: Functional Usability",
      "description": "补齐设计规范中的功能差距，使核心答题流程完整可用",
      "status": "completed",
      "phases": [3],
      "depends_on": "P2",
      "tasks": [
        "AI 提示词结构化改造",
        "全自动答题流程补全",
        "HUD 单行紧凑布局",
        "题库目录自动扫描",
        "OCR 文本预处理",
        "启动按钮状态逻辑",
        "配置管理清理"
      ],
      "success_criteria": [
        "全自动模式下填空题/简答题可自动输入文字内容",
        "AI 识别返回结构化 JSON（含题型、选项坐标、置信度）",
        "HUD 显示为单行紧凑格式，题目截断长度自适应屏幕宽度",
        "启动时 db/ 目录下所有 .db 文件自动出现在下拉列表中",
        "启动按钮在配置不完整时显示明确的文字提示并禁用"
      ]
    },
    {
      "id": "P4",
      "name": "Phase 4: MiMo-V2.5 Integration",
      "description": "接入 Xiaomi MiMo-V2.5 多模态模型，实现模型预设配置和切换",
      "status": "completed",
      "phases": [4],
      "depends_on": "P3",
      "tasks": [
        "MiMo API 兼容性验证",
        "模型预设配置系统",
        "图片编码适配",
        "响应格式适配",
        "模型切换 UI",
        "基准测试框架",
        "文档和配置更新"
      ],
      "success_criteria": [
        "用户可在设置中一键选择 MiMo-V2.5 预设",
        "MiMo-V2.5 结构化 JSON 解析成功率 ≥ 90%",
        "模型切换不影响已有功能",
        "基准测试可重复运行"
      ]
    },
    {
      "id": "P5",
      "name": "Phase 5: Core Functionality Hardening",
      "description": "核心功能加固：重复画面检测修复、引擎超时保护、识别结果过滤、HUD 截断修复、模型预设扩展、半自动模式修正",
      "status": "completed",
      "phases": [5],
      "depends_on": "P4",
      "tasks": [
        "pHash Hamming 距离替代精确匹配",
        "引擎识别调用超时保护",
        "Prompt A+B 空结果过滤",
        "HUD 截断逻辑修复",
        "模型预设扩展 (10+ 视觉模型)",
        "半自动 answered 标记时机修正"
      ],
      "success_criteria": [
        "pHash 相似屏幕正确判重（Hamming ≤ 8）",
        "AI 调用有超时保护，引擎不阻塞",
        "Prompt A+B 均失败时返回 None",
        "HUD 显示不溢出窗口",
        "MODEL_PRESETS 包含 10+ 视觉模型",
        "半自动模式等待用户确认后标记"
      ]
    },
    {
      "id": "P6",
      "name": "Phase 6: Quiz Website & E2E Testing",
      "description": "构建 Web 答题网站、题库抽题与题干改写（相似度 ≤ 10%）、网络编撰题目（25%）、全自动/半自动端到端测试（题库题 ≥ 95%）",
      "status": "completed",
      "phases": [6],
      "depends_on": "P5",
      "tasks": [
        "题库数据准备：抽题 + AI 改写 (37 道，相似度 ≤ 10%)",
        "网络题目编撰 (13 道，覆盖 IT/安全/编程/数据库)",
        "题库格式转换与合并 (50 道 JSON 数据集)",
        "Web 答题网站后端 (Flask API)",
        "Web 答题网站前端 (参考截图设计)",
        "VisionQuiz Prompt 调优 (Web 页面截图)",
        "全自动模式集成测试 (题库题 ≥ 95%)",
        "全自动模式调试迭代 (最多 3 轮)",
        "半自动模式集成测试 (题库题 ≥ 95%)",
        "半自动模式调试迭代 (最多 3 轮)",
        "E2E 测试报告生成"
      ],
      "success_criteria": [
        "答题网站包含 50 道题（单选+多选）",
        "改写题干 TF-IDF 余弦相似度 ≤ 10%",
        "全自动模式题库题正确率 ≥ 95%（35/37）",
        "半自动模式题库题正确率 ≥ 95%",
        "网络题识别率正常（题干正确识别即可）"
      ]
    },
    {
      "id": "P7",
      "name": "Phase 7: ElementProvider Architecture",
      "description": "引入 ElementProvider 抽象层替代截图+AI视觉识别，双线并行开发 Browser（Playwright CDP）和 Windows（UI Automation）两种元素提供器，新增 4 种模式",
      "status": "completed",
      "phases": [7],
      "depends_on": "P6",
      "tasks": [
        "ElementProvider 抽象接口定义",
        "BrowserElementProvider 实现（Playwright CDP）",
        "WindowsElementProvider 实现（UI Automation）",
        "Engine ElementProvider 集成",
        "Recognizer 元素读取策略",
        "Clicker 元素操作适配",
        "4 种新模式 UI 与配置",
        "Browser 模式 E2E 测试",
        "Windows 模式 E2E 测试",
        "Legacy 模式兼容验证",
        "性能基准测试",
        "架构文档与迁移指南"
      ],
      "success_criteria": [
        "ElementProvider 接口定义清晰，两种实现可独立工作",
        "Browser 模式 Web 答题站 E2E 题库题正确率 100%",
        "Windows 模式 UI Automation 控件读取成功率 ≥ 95%",
        "Token 消耗新模式 vs legacy 降低 ≥ 60%",
        "响应速度新模式 tick 延迟 ≤ 2s",
        "Legacy 模式无回归，P1-P6 测试全部通过"
      ]
    }
