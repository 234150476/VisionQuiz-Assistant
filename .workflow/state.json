  "milestones": [
    {
      "id": "P1",
      "name": "Phase 1: Core Stability",
      "description": "修复 engine/recognizer/cache/ai_client/ocr/screenshot 的异常处理、资源管理和容错机制",
      "status": "completed",
      "phases": [1],
      "tasks": [
        "Engine 线程安全与异常容错",
        "Recognizer 多策略管道容错",
        "AIClient 网络容错与重试",
        "CacheDB 连接管理与线程安全",
        "OCR/Screenshot 模块容错"
      ],
      "success_criteria": [
        "AI API 调用失败时引擎不会卡死，继续下一轮截图循环",
        "OCR 模型不存在时程序正常运行（单轨 AI Vision 模式）",
        "引擎 stop() 在任何状态下都能在 5 秒内完成，不留孤儿线程",
        "缓存数据库连接在任何异常路径下都不会泄漏"
      ]
    },
    {
      "id": "P2",
      "name": "Phase 2: UI Stability",
      "description": "修复主线程阻塞、窗口竞态、错误展示和优雅关闭",
      "status": "completed",
      "phases": [2],
      "depends_on": "P1",
      "tasks": [
        "MainWindow 停止流程优化",
        "关窗竞态修复",
        "HUD 错误展示与恢复",
        "SettingsDialog/DBViewer 异常处理",
        "跨模块错误传播链"
      ],
      "success_criteria": [
        "引擎停止时 UI 主线程不冻结，按钮即时响应",
        "关闭窗口时不会出现 \"应用程序未响应\" 或残留进程",
        "所有运行时错误在 HUD 上有清晰的用户提示（非 Python traceback）",
        "配置/题库文件损坏时给出友好提示而非崩溃"
      ]
    },
    {
      "id": "P3",
      "name": "Phase 3: Functional Usability",
      "description": "补齐设计规范中的功能差距，使核心答题流程完整可用",
      "status": "completed",
      "phases": [3],
      "depends_on": "P2",
      "tasks": [
        "AI 提示词结构化改造",
        "全自动答题流程补全",
        "HUD 单行紧凑布局",
        "题库目录自动扫描",
        "OCR 文本预处理",
        "启动按钮状态逻辑",
        "配置管理清理"
      ],
      "success_criteria": [
        "全自动模式下填空题/简答题可自动输入文字内容",
        "AI 识别返回结构化 JSON（含题型、选项坐标、置信度）",
        "HUD 显示为单行紧凑格式，题目截断长度自适应屏幕宽度",
        "启动时 db/ 目录下所有 .db 文件自动出现在下拉列表中",
        "启动按钮在配置不完整时显示明确的文字提示并禁用"
      ]
    },
    {
      "id": "P4",
      "name": "Phase 4: MiMo-V2.5 Integration",
      "description": "接入 Xiaomi MiMo-V2.5 多模态模型，实现模型预设配置和切换",
      "status": "pending",
      "phases": [4],
      "depends_on": "P3",
      "tasks": [
        "MiMo API 兼容性验证",
        "模型预设配置系统",
        "图片编码适配",
        "响应格式适配",
        "模型切换 UI",
        "基准测试框架",
        "文档和配置更新"
      ],
      "success_criteria": [
        "用户可在设置中一键选择 MiMo-V2.5 预设",
        "MiMo-V2.5 结构化 JSON 解析成功率 ≥ 90%",
        "模型切换不影响已有功能",
        "基准测试可重复运行"
      ]
    }
